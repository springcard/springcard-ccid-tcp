# SpringCard CCID TCP reader configuration for pcsc-lite.
#
# This file is installed as an empty, commented example. pcscd reads reader
# definitions from the directory configured as serialconfdir, typically:
#
#     /etc/reader.conf.d
#
# Add one block per network reader and restart pcscd. The LIBPATH below is
# generated at install time for this build.
#
# Example using the legacy positional DEVICENAME format:
#
# FRIENDLYNAME      "SpringCard CCID TCP"
# DEVICENAME        192.168.17.100:3999:00:nokey
# LIBPATH           TARGET
# CHANNELID         0
#
# DEVICENAME format:
#
#     host:port:option:key
#
# The newer named format is also accepted:
#
# FRIENDLYNAME      "SpringCard CCID TCP"
# DEVICENAME        host=192.168.17.100:port=3999:options=0x00:key=nokey:slots=1
# LIBPATH           TARGET
# CHANNELID         0
#
# Supported named fields:
#
# - host: reader host name or IPv4 address, mandatory
# - port: TCP port, default 3999
# - options: reader option byte, default 0x00
# - key: reader key string, empty by default
# - slots: number of slots exposed by this reader, default 1
#
# Configuration may also be moved to an external INI-style file:
#
# FRIENDLYNAME      "SpringCard CCID TCP"
# DEVICENAME        file=/etc/springcard-ccid-tcp/readers.conf
# LIBPATH           TARGET
# CHANNELID         0
#
# Or select a specific section:
#
# DEVICENAME        file=/etc/springcard-ccid-tcp/readers.conf:section=front-desk
#
# External configuration example:
#
# [front-desk]
# host=192.168.17.100
# port=3999
# options=0x00
# key=nokey
# slots=1
# hook=/usr/local/sbin/springcard-reader-hook
#
# In external files, host is mandatory. Defaults are port=3999, options=0x00,
# key=nokey, slots=1 and the installed springcard-ccid-tcp-hook script.
